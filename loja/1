        <button class="prod-qbtn" onclick="changeQty('${p.id}',-1)">−</button>
        <span class="prod-qnum" id="qty-${p.id}">${formatQty(qty, tipoEscolhido)}</span>
        <button class="prod-qbtn" onclick="changeQty('${p.id}',1)">+</button>
      </div>
    </div>`;
  }).join('');
}

function formatQty(qty, tipo){
  if(tipo === 'kg') return qty < 1 ? (qty*1000)+'g' : qty+'kg';
  return qty;
}

function toggleProduto(id){
  const item = PRODUTOS.find(p => p.id === id);
  if(!item) return;
  if(carrinho.find(i => i.id === id)) return;

  const tipo = item.tipo_venda === 'kg' ? 'kg' : 'un';
  const min = item.min_medida || 1;

  carrinho.push({
    id: item.id, nome: item.nome, preco: item.preco,
    unidade: tipo === 'kg' ? 'kg' : (item.unidade||'un'),
    qty: min, total: item.preco * min,
    corredor: item.corredor, tipoVendaEscolhido: tipo, min_medida: min
  });
  atualizarCard(id);
  renderCorredores();
  renderDrawer();
  updateResumo();
  mostrarToast(`✅ ${item.nome}`);
}

function setTipoVenda(id, tipo){
  const idx = carrinho.findIndex(i => i.id === id);
  const prod = PRODUTOS.find(p => p.id === id);
  if(!prod) return;

  if(idx === -1){
    const min = prod.min_medida || 1;
    carrinho.push({
      id: prod.id, nome: prod.nome, preco: prod.preco,
      unidade: tipo==='kg'?'kg':(prod.unidade||'un'),
      qty: min, total: prod.preco * min,
      corredor: prod.corredor, tipoVendaEscolhido: tipo, min_medida: min
    });
  } else {
    carrinho[idx].tipoVendaEscolhido = tipo;
    carrinho[idx].unidade = tipo==='kg'?'kg':(prod.unidade||'un');
    const min = carrinho[idx].min_medida || 1;
    carrinho[idx].qty = min;
    carrinho[idx].total = carrinho[idx].preco * min;
  }
  atualizarCard(id);
  renderCorredores();
  renderDrawer();
  updateResumo();
}

function changeQty(id, delta){
  const idx = carrinho.findIndex(i => i.id === id);
  const prod = PRODUTOS.find(p => p.id === id);
  if(!prod) return;

  if(idx === -1 && delta > 0){ toggleProduto(id); return; }
  if(idx === -1) return;

  const item = carrinho[idx];
  const min = item.min_medida || 1;
  const step = item.tipoVendaEscolhido === 'kg' ? (min < 1 ? min : 0.5) : 1;
  let nova = Math.round((item.qty + delta * step) * 100) / 100;

  if(nova < min){
    carrinho.splice(idx, 1);
  } else {
    item.qty = nova;
    item.total = item.preco * item.qty;
  }
  atualizarCard(id);
  renderCorredores();
  renderDrawer();
  updateResumo();
}

function atualizarCard(id){
  const el = document.getElementById('prod-'+id);
  if(!el) return;
  const item = carrinho.find(i => i.id === id);
  const qtyEl = document.getElementById('qty-'+id);
  if(item){
    el.classList.add('selected');
    if(qtyEl) qtyEl.textContent = formatQty(item.qty, item.tipoVendaEscolhido);
    el.querySelectorAll('.tipo-venda-btn').forEach(btn => {
      const isUn = btn.textContent.trim().toLowerCase() === 'unidade';
      btn.classList.toggle('active', (isUn && item.tipoVendaEscolhido==='un') || (!isUn && item.tipoVendaEscolhido==='kg'));
    });
  } else {
    el.classList.remove('selected');
    if(qtyEl) qtyEl.textContent = '1';
  }
}

