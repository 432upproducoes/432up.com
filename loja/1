/* ===== MODO ESCURO (Apple-style) + MENU ===== */
const THEME_KEY = 'faco_mercado_tema';

function aplicarTema(tema){
  const isDark = tema === 'dark';
  document.documentElement.classList.toggle('dark', isDark);
  const btn = document.getElementById('btn-theme');
  const menuIcon = document.getElementById('menu-theme-icon');
  const menuLabel = document.getElementById('menu-theme-label');
  if(btn) btn.textContent = isDark ? '☀️' : '🌙';
  if(menuIcon) menuIcon.textContent = isDark ? '☀️' : '🌙';
  if(menuLabel) menuLabel.textContent = isDark ? 'Modo Dia' : 'Modo Noturno';
}

function initTheme(){
  const salvo = localStorage.getItem(THEME_KEY);
  if(salvo === 'dark' || salvo === 'light'){
    aplicarTema(salvo);
  } else {
    const prefereEscuro = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    aplicarTema(prefereEscuro ? 'dark' : 'light');
  }
  // Acompanha mudança de preferência do sistema, caso o usuário não tenha escolhido manualmente
  if(window.matchMedia){
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if(!localStorage.getItem(THEME_KEY)) aplicarTema(e.matches ? 'dark' : 'light');
    });
  }
}

function toggleTheme(){
  const isDark = document.documentElement.classList.contains('dark');
  const novoTema = isDark ? 'light' : 'dark';
  aplicarTema(novoTema);
  localStorage.setItem(THEME_KEY, novoTema);
}

