        <div class="tipo-venda-btn ${tipoEscolhido==='kg'?'active':''}" onclick="setTipoVenda('${p.id}','kg')">Quilo</div>
      </div>`;
    }

    return `
    <div class="prod-item ${selected}" id="prod-${p.id}" onclick="toggleProduto('${p.id}')">
