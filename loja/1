<script>
const SB_URL = 'https://qfrsfdqbhgunykgvozcx.supabase.co';
const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFmcnNmZHFiaGd1bnlrZ3ZvemN4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg1MDM2MjAsImV4cCI6MjA5NDA3OTYyMH0.tzFThSsbOviLDd_f9rmNylPF7v5rmrbXl3JR7vL7_so';
const ZAP_NUM = '5511934941652';
const MINIMO_DEL = 25;

const CUPONS = { 'MERCADO10': { codigo:'MERCADO10', tipo:'pct', valor:10, desc:'10% de desconto' } };

/* ===== CATÁLOGO (Corredores + Produtos) =====
   Vem de um arquivo externo que hoje faz o papel do banco de dados.
   Pra trocar de local pra Supabase depois, troca só o valor de DB_URL
   pela URL da tabela/endpoint real — o resto do código não muda. */
const DB_URL = './banco-dados-mercadinho.json';
let CORREDORES = [];
let PRODUTOS = [];
let catalogoErro = false;

async function loadCatalogo(){
  catalogoErro = false;
  try{
    const res = await fetch(DB_URL);
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    CORREDORES = data.corredores || [];
    PRODUTOS = data.produtos || [];
    if(!CORREDORES.length || !PRODUTOS.length) catalogoErro = true;
  }catch(e){
    console.error('Falha ao carregar catálogo:', e);
    catalogoErro = true;
  }
}

function estadoSemDadosHTML(){
  return `<div class="empty-state">
    <span class="big">📭</span>
    <div class="empty-state-msg">Sem dados no momento. Aguarde ou tente mais tarde.</div>
    <button class="empty-state-zap" onclick="pedirPeloZap()">💬 Fazer pedido pelo WhatsApp</button>
  </div>`;
}

function pedirPeloZap(){
  const msg = encodeURIComponent('Olá! Gostaria de fazer um pedido no Mercadinho 🛒');
  const url = 'https://wa.me/'+ZAP_NUM+'?text='+msg;
  const w = window.open(url, '_blank');
  if(!w) window.location.href = url;
}

function renderEstadoInicialProdutos(){
  const grid = document.getElementById('prod-grid');
  if(!grid) return;
  if(catalogoErro || !CORREDORES.length || !PRODUTOS.length){
    grid.innerHTML = estadoSemDadosHTML();
  } else {
    grid.innerHTML = `<div class="empty-corredor" style="grid-column:1/-1"><span class="big">🛒</span>Toque em um corredor para ver os produtos</div>`;
  }
}

const BAIRROS = [
  {nome:'Jd. São Miguel',taxa:5},{nome:'Jd. Iguatemi',taxa:7},
  {nome:'Vila Mota',taxa:8},{nome:'Centro',taxa:8},
  {nome:'Lago do Taboão',taxa:12},{nome:'Jd. do Sul',taxa:12}
];

const S = { nome:'', categoria:null, entrega:null, bairroNome:null, frete:0, horario:null, cupom:null, desconto:0 };
let carrinho = [];

/* ===== STORAGE (Faço ID + Histórico) — v6 ===== */
function getIdStorage(){
  try{ return JSON.parse(localStorage.getItem('faco_mercado')||'{}'); }
  catch(e){ return {}; }
}
function setIdStorage(data){
  localStorage.setItem('faco_mercado', JSON.stringify(data));
}
function salvarHistoricoPedido(){
  const st = getIdStorage();
  if(!st.historico) st.historico = {};
  if(!st.historico[S.nome]) st.historico[S.nome] = [];
  st.historico[S.nome].unshift({
    data: new Date().toISOString(),
    total: calcTotal(),
    itens: JSON.parse(JSON.stringify(carrinho))
  });
  st.historico[S.nome] = st.historico[S.nome].slice(0, 3);
  setIdStorage(st);
}

/* ===== NAV entre telas 1/2/3 ===== */
function irParaId(){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-id').classList.add('active');
  window.scrollTo(0,0);
}
function irParaHome(){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-home').classList.add('active');
  renderUltimasCompras();
  renderBigCorredores();
  window.scrollTo(0,0);
}
function irParaProdutos(){
