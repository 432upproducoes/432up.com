function calcCarrinho(){ return carrinho.reduce((s,it) => s + it.total, 0); }
function calcTotal(){
  const sub = calcCarrinho();
  let desc = 0;
  if(S.cupom) desc = S.cupom.tipo==='pct' ? sub * S.cupom.valor/100 : S.cupom.valor;
  S.desconto = Math.min(desc, sub);
  return sub - S.desconto + S.frete;
}
