<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Monte seu Pedido — Faço Pedidos · Mercadinho</title>
<link rel="icon" type="image/png" href="img/logo.png">
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --roxo:#166534;--roxo2:#15803D;--roxo3:#22C55E;
  --amarelo:#EAB308;--amarelo2:#FACC15;
  --rosa:#F97316;--azul:#0EA5E9;--verde:#16A34A;
  --text:#1E293B;--off:#F0FDF4;

  /* superfícies (trocam no modo escuro) */
  --bg-app:#F0FDF4;
  --surface:#FFFFFF;
  --surface-2:#F0FDF4;
  --border-soft:#BBF7D0;
  --muted:#888888;
  --selected-bg:#DCFCE7;
  --shadow-deep:#14532D;

  /* gradientes de headers/cards (hero, home, checkout, drawer, resumo...) */
  --hdr-1:#14532D; --hdr-2:#166534; --hdr-3:#15803D;
}

/* ===== MODO ESCURO — paleta estilo iOS/macOS (grafite/ardósia equilibrado, nunca preto puro nem verde neon) ===== */
html.dark{
  --roxo:#5EEAD4;--roxo2:#2DD4BF;--roxo3:#99F6E4;
  --amarelo:#F5C451;--amarelo2:#F7D374;
  --rosa:#FDA55D;--azul:#7DD3FC;--verde:#5EEAD4;
  --text:#E7E9EC;--off:#1B1E24;

  --bg-app:#121417;
  --surface:#1D2025;
  --surface-2:#24272D;
  --border-soft:#33373E;
  --muted:#9199A3;
  --selected-bg:#2A2E33;
  --shadow-deep:#000000;

  /* headers viram grafite/ardósia — o verde só aparece como leve sotaque no texto/ícones, não no fundo */
  --hdr-1:#15171B; --hdr-2:#20232A; --hdr-3:#2A2E36;
}
html.dark body{background:var(--bg-app);}
html.dark .id-card,
html.dark .order-card,
html.dark .big-chip,
html.dark .corredor-chip,
html.dark .prod-item,
html.dark .block-card,
html.dark .field-input,
html.dark .bairro-btn,
html.dark .ent-btn,
html.dark .pill,
html.dark .tipo-venda-btn,
html.dark #faco-id-bar,
html.dark #corredores-wrap,
html.dark .cupom-row .field-input{
  background:var(--surface); border-color:var(--border-soft); color:var(--text);
}
html.dark .id-input,
html.dark .faco-id-input{ background:var(--surface); color:var(--text); border-color:var(--border-soft); }
html.dark .faco-id-input.ok{ background:var(--selected-bg); }
html.dark .prod-item:hover{background:var(--surface-2);}
html.dark .prod-item.selected,
html.dark .ent-btn.selected,
html.dark .bairro-btn.selected,
html.dark .corredor-chip.active{ background:var(--selected-bg); }
html.dark .corredor-chip.has-items{ background:var(--surface-2); border-color:var(--amarelo); }
html.dark .big-title,html.dark .last-title{color:var(--roxo);}
html.dark .block-badge{background:var(--surface-2);color:var(--muted);}
html.dark .empty-corredor{color:var(--muted);}
html.dark .prod-marca,html.dark .prod-unidade,html.dark .order-items,html.dark .ent-sub{color:var(--muted);}
html.dark .minimo-warn{background:#3A331A;border-color:var(--amarelo2);color:var(--amarelo2);}
html.dark .cupom-err{background:#3A2222;border-color:#F87171;color:#FCA5A5;}
html.dark #status-bar.aberto{background:linear-gradient(90deg,#173A2E,#1F5C46);}
html.dark #status-bar.fechado{background:linear-gradient(90deg,#3A1E1E,#5C2626);}
html.dark .tipo-venda-btn.active{background:var(--roxo2);color:#0B0D10;border-color:var(--roxo2);}
html.dark .id-btn,
html.dark .prod-qbtn{ background:linear-gradient(135deg,var(--hdr-2),var(--hdr-3)); }
html.dark .obg-btn,
html.dark .fb-pedir{ color:#14171B; }
html.dark .order-total,
html.dark .prod-preco,
html.dark .bairro-taxa{ color:var(--roxo); }
html.dark .prod-item.selected .prod-qty-row{ background:rgba(94,234,212,.14); }
html.dark #corredores-wrap{ box-shadow:0 4px 12px rgba(0,0,0,.35); }
html.dark .corredor-chip.active{ box-shadow:0 4px 0 rgba(0,0,0,.35); }
html.dark .prod-item.selected{ box-shadow:0 0 0 2px rgba(94,234,212,.25); }
html.dark #toast{ background:rgba(29,32,37,.96); }

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth; height:100%;}
body{
  font-family:'Nunito',sans-serif;color:var(--text);
  background:var(--bg-app);
  min-height:100vh;
  min-height:100dvh;
  padding-bottom:calc(86px + env(safe-area-inset-bottom));
  transition:background .25s ease, color .25s ease;
}

/* ===== BOTÃO FIXO DE TEMA + MENU ===== */
#topbar-controls{
  position:fixed; top:calc(10px + env(safe-area-inset-top)); right:10px; z-index:9999;
  display:flex; gap:8px;
}
.tb-btn{
  width:40px;height:40px;border-radius:50%;border:2px solid var(--amarelo);
  background:rgba(0,0,0,.35); color:white; font-size:1.05rem;
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  backdrop-filter:blur(6px); box-shadow:0 3px 10px rgba(0,0,0,.25);
}
.tb-btn:active{transform:scale(.92);}
#menu-dropdown{
  position:fixed; top:calc(56px + env(safe-area-inset-top)); right:10px; z-index:9999;
  background:var(--surface); border:2px solid var(--border-soft); border-radius:14px;
  min-width:170px; box-shadow:0 10px 30px rgba(0,0,0,.25); overflow:hidden;
  display:none;
}
#menu-dropdown.open{display:block;}
.menu-item{
  padding:12px 14px; font-weight:800; font-size:.85rem; color:var(--text);
  cursor:pointer; display:flex; align-items:center; gap:8px;
}
.menu-item:hover{background:var(--surface-2);}
.menu-item.danger{color:#DC2626;}

/* ===== LOADING (3 bolinhas) ===== */
.loading-wrap{
  grid-column:1/-1; display:flex; flex-direction:column; align-items:center;
  justify-content:center; gap:12px; padding:50px 20px;
}
.loading-dots{ display:flex; gap:8px; }
.loading-dots span{
  width:12px;height:12px;border-radius:50%;
  background:var(--roxo);
  animation:loadingBlink 1.1s ease-in-out infinite;
}
.loading-dots span:nth-child(1){background:var(--roxo); animation-delay:0s;}
.loading-dots span:nth-child(2){background:var(--amarelo); animation-delay:.18s;}
.loading-dots span:nth-child(3){background:var(--roxo3); animation-delay:.36s;}
@keyframes loadingBlink{
  0%,80%,100%{transform:scale(.6);opacity:.4;}
  40%{transform:scale(1);opacity:1;}
}
.loading-label{font-weight:800;font-size:.82rem;color:var(--muted);}

/* ===== ESTADO SEM DADOS / ERRO ===== */
.empty-state{
  grid-column:1/-1; text-align:center; padding:36px 20px;
  display:flex; flex-direction:column; align-items:center; gap:10px;
}
.empty-state .big{font-size:2.6rem;}
.empty-state-msg{font-weight:800;color:var(--muted);font-size:.9rem;max-width:260px;}
.empty-state-zap{
  margin-top:6px; background:linear-gradient(135deg,#25D366,#1DA851);
  color:white;border:none;border-radius:14px;padding:12px 20px;
  font-family:'Fredoka One',cursive;font-size:.95rem;cursor:pointer;
  display:flex;align-items:center;gap:8px;box-shadow:0 4px 0 #1a9e45;
}
.empty-state-zap:active{transform:translateY(2px);box-shadow:0 2px 0 #1a9e45;}

/* PAGINAS */
.page{ display:none; }
.page.active{ display:block; }

/* ===== TELA 1 - FAÇO ID (v6) ===== */
#page-id{
  min-height:100vh; min-height:100dvh;
  background:linear-gradient(160deg,var(--hdr-1),var(--hdr-2));
  padding:24px;
}
#page-id.active{
  display:flex; align-items:center; justify-content:center;
}
.id-card{
  background:white; border-radius:28px; padding:36px 28px;
  width:100%; max-width:380px; text-align:center;
  border:4px solid var(--amarelo);
  box-shadow:0 20px 50px rgba(0,0,0,0.25);
  margin:0 auto;
}
.id-logo{
  width:84px; height:84px; border-radius:50%;
  border:4px solid var(--amarelo); margin:0 auto 14px;
  display:block; background:var(--off); object-fit:contain;
}
.id-title{ font-family:'Fredoka One',cursive; font-size:1.6rem; color:var(--roxo); }
.id-sub{ font-size:.85rem; color:#666; margin:6px 0 24px; font-weight:700; }
.id-input{
  width:100%; border:2.5px solid var(--border-soft); border-radius:16px;
  padding:14px; font-size:1.05rem; font-weight:800;
  text-align:center; outline:none; margin-bottom:14px;
  color:var(--roxo); font-family:'Nunito',sans-serif;
}
.id-input:focus{ border-color:var(--roxo); }
.id-btn{
  width:100%; background:linear-gradient(135deg,var(--roxo),var(--roxo3));
  color:white; border:none; border-radius:16px; padding:16px;
  font-family:'Fredoka One',cursive; font-size:1.15rem;
  cursor:pointer; box-shadow:0 5px 0 var(--shadow-deep);
}
.id-btn:active{ transform:translateY(2px); box-shadow:0 2px 0 var(--shadow-deep); }

/* ===== TELA 2 - HOME (v6) ===== */
#page-home{ min-height:100vh; min-height:100dvh; }
.home-header{
  background:linear-gradient(135deg,var(--hdr-1),var(--hdr-2));
  padding:18px 16px 14px; color:white; position:sticky; top:0; z-index:20;
}
.home-hello{ font-family:'Fredoka One',cursive; font-size:1.35rem; }
.home-sub{ font-size:.8rem; opacity:.85; margin-top:2px; }
.home-change{ font-size:.75rem; color:var(--amarelo); font-weight:800; margin-top:6px; cursor:pointer; display:inline-block; }
.home-back{
  position:absolute; left:16px; top:16px; width:34px; height:34px;
  border-radius:50%; background:rgba(255,255,255,.18); color:white;
  border:none; font-size:1.1rem; display:flex; align-items:center; justify-content:center;
}
.last-orders{ padding:14px 14px 4px; }
.last-title{ font-family:'Fredoka One',cursive; font-size:.95rem; color:var(--roxo); margin-bottom:10px; }
.order-card{
  background:white; border:2.5px solid var(--border-soft); border-radius:16px;
  padding:12px 14px; margin-bottom:8px; cursor:pointer;
  display:flex; align-items:center; gap:12px;
}
.order-card:active{ border-color:var(--roxo); }
.order-icon{ font-size:1.5rem; }
.order-info{ flex:1; }
.order-date{ font-weight:800; font-size:.84rem; color:var(--roxo); }
.order-total{ font-family:'Fredoka One',cursive; font-size:1rem; color:#15803D; }
.order-items{ font-size:.72rem; color:#888; }
.order-btn{
  background:var(--roxo); color:white; border:none; border-radius:10px;
  padding:7px 12px; font-family:'Fredoka One',cursive; font-size:.75rem;
}
.big-corredores{ padding:8px 14px 40px; }
.big-title{ font-family:'Fredoka One',cursive; font-size:1.05rem; color:var(--roxo); margin-bottom:12px; }
.big-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.big-chip{
  background:white; border:3px solid var(--border-soft); border-radius:20px;
  padding:16px 8px; text-align:center; cursor:pointer;
}
.big-chip:active{ border-color:var(--roxo); background:var(--off); transform:scale(0.97); }
.big-emoji{ font-size:2.1rem; display:block; margin-bottom:5px; }
.big-nome{ font-family:'Fredoka One',cursive; font-size:.82rem; color:var(--roxo); }

#hero{
  background:linear-gradient(135deg,var(--hdr-1),var(--hdr-2),var(--hdr-3));
  padding:16px 16px 12px;text-align:center;position:relative;
}
.hero-inner{display:flex;align-items:center;justify-content:center;gap:12px;}
.hero-logo{
  width:48px;height:48px;border-radius:50%;
  border:3px solid var(--amarelo);object-fit:contain;background:white;
}
.hero-text{text-align:left;}
.hero-title{font-family:'Fredoka One',cursive;font-size:1.25rem;color:white;line-height:1.1;}
.hero-sub{font-size:.7rem;color:var(--amarelo);font-weight:800;letter-spacing:1px;text-transform:uppercase;}

#status-bar{padding:6px 16px;text-align:center;font-weight:800;font-size:.78rem;}
#status-bar.aberto{background:linear-gradient(90deg,#166534,#22C55E);color:white;}
#status-bar.fechado{background:linear-gradient(90deg,#7A1A1A,#C0392B);color:white;}

#faco-id-bar{
  background:white;border-bottom:2px solid var(--border-soft);
  padding:10px 16px;display:flex;align-items:center;gap:10px;
  position:sticky;top:0;z-index:60;
}
.faco-id-label{font-family:'Fredoka One',cursive;font-size:.85rem;color:var(--roxo);white-space:nowrap;}
.faco-id-input{
  flex:1;border:2px solid var(--border-soft);border-radius:12px;
  padding:8px 12px;font-family:'Nunito',sans-serif;font-size:.9rem;
  font-weight:700;outline:none;color:var(--text);
}
.faco-id-input:focus{border-color:var(--roxo);}
.faco-id-input.ok{border-color:var(--verde);background:var(--surface-2);}
.faco-id-ok{display:none;font-size:1.1rem;}

#corredores-wrap{
  background:white;
  border-bottom:3px solid var(--amarelo);
  position:sticky;top:52px;z-index:55;
  box-shadow:0 4px 12px rgba(22,101,52,.08);
}
.corredores-track{
  display:flex;gap:8px;padding:10px 14px;
  overflow-x:auto;scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;scrollbar-width:none;
}
.corredores-track::-webkit-scrollbar{display:none;}

.corredor-chip{
  flex-shrink:0;scroll-snap-align:start;
  border:2.5px solid var(--border-soft);border-radius:16px;
  padding:10px 14px 8px;min-width:88px;max-width:110px;
  text-align:center;cursor:pointer;background:white;
  transition:all .25s ease;position:relative;
  display:flex;flex-direction:column;align-items:center;gap:2px;
}
.corredor-chip:hover{transform:translateY(-2px);}
.corredor-chip.active{
  border-color:var(--roxo);
  background:linear-gradient(160deg,var(--surface-2),var(--selected-bg));
  box-shadow:0 4px 0 rgba(22,101,52,.15);
  min-width:100px;
}
.corredor-chip.has-items{
  border-color:var(--amarelo);
  background:linear-gradient(160deg,#FEFCE8,#FEF9C3);
}
.corredor-chip.has-items .chip-badge{ display:flex; }
.chip-emoji{font-size:1.6rem;line-height:1;}
.chip-nome{font-family:'Fredoka One',cursive;font-size:.72rem;color:var(--roxo);line-height:1.15;margin-top:2px;}
.chip-badge{
  display:none;position:absolute;top:-6px;right:-6px;
  background:var(--rosa);color:white;font-size:.65rem;font-weight:900;
  width:20px;height:20px;border-radius:50%;
  align-items:center;justify-content:center;
  border:2px solid white;box-shadow:0 2px 4px rgba(0,0,0,.2);
}

main{max-width:700px;margin:0 auto;padding:14px 12px 20px;}

.section-title{
  font-family:'Fredoka One',cursive;font-size:1.15rem;color:var(--roxo);
  margin-bottom:12px;display:flex;align-items:center;gap:8px;
}
.section-title span{font-size:.75rem;font-weight:700;color:#888;font-family:'Nunito',sans-serif;}

.prod-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
@media(max-width:400px){.prod-grid{grid-template-columns:1fr;}}

.prod-item{
  border:2.5px solid var(--border-soft);border-radius:16px;padding:12px;
  background:white;transition:all .2s;position:relative;
  display:flex;flex-direction:column;gap:4px;
}
.prod-item:hover{background:var(--surface-2);}
.prod-item.selected{
  border-color:var(--roxo);background:var(--selected-bg);
  box-shadow:0 0 0 2px rgba(22,101,52,.12);
}
.prod-nome{font-family:'Fredoka One',cursive;font-size:.9rem;color:var(--roxo);line-height:1.2;}
.prod-marca{font-size:.68rem;color:#888;}
.prod-preco{font-family:'Fredoka One',cursive;font-size:.98rem;color:#15803D;margin-top:2px;}
.prod-unidade{font-size:.68rem;color:#888;font-weight:700;}

.tipo-venda-row{display:none;gap:5px;margin-top:6px;}
.prod-item.selected .tipo-venda-row{display:flex;}
.tipo-venda-btn{
  flex:1;border:2px solid var(--border-soft);border-radius:10px;padding:5px 2px;
  font-size:.68rem;font-weight:800;text-align:center;cursor:pointer;
  background:white;color:var(--roxo);transition:all .15s;
}
.tipo-venda-btn.active{background:var(--roxo);color:white;border-color:var(--roxo);}

.prod-qty-row{
  display:none;align-items:center;justify-content:center;gap:10px;margin-top:8px;
  background:rgba(22,101,52,.08);border-radius:30px;padding:5px 8px;
}
.prod-item.selected .prod-qty-row{display:flex;}
.prod-qbtn{
  width:32px;height:32px;border-radius:50%;border:none;
  background:linear-gradient(135deg,var(--roxo),var(--roxo3));
  color:white;font-size:1.15rem;font-family:'Fredoka One',cursive;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  box-shadow:2px 2px 0 var(--amarelo);
}
.prod-qbtn:active{transform:scale(.9);}
.prod-qnum{font-family:'Fredoka One',cursive;font-size:1.15rem;color:var(--roxo);min-width:36px;text-align:center;}

.empty-corredor{
  text-align:center;padding:40px 20px;color:#aaa;
  font-weight:700;font-size:.9rem;
}
.empty-corredor .big{font-size:2.5rem;display:block;margin-bottom:8px;}

.checkout-top{
  background:linear-gradient(135deg,var(--hdr-1),var(--hdr-2));
  padding:14px 16px;display:flex;align-items:center;gap:10px;
  position:sticky;top:0;z-index:60;
}
.checkout-back{
  background:rgba(255,255,255,.15);border:none;color:white;
  border-radius:10px;width:36px;height:36px;font-size:1.15rem;cursor:pointer;
  flex-shrink:0;
}
.checkout-title{font-family:'Fredoka One',cursive;font-size:1.1rem;color:white;flex:1;}
.checkout-count{font-size:.72rem;color:var(--amarelo);font-weight:800;}

.block-card{
  background:white;border-radius:16px;margin-bottom:12px;
  border:2px solid var(--border-soft);overflow:hidden;
}
.block-header{
  display:flex;align-items:center;gap:10px;padding:12px 14px;
  cursor:pointer;user-select:none;
}
.block-icon{font-size:1.2rem;}
.block-title{font-family:'Fredoka One',cursive;font-size:.95rem;color:var(--roxo);flex:1;}
.block-badge{font-size:.7rem;font-weight:800;color:#888;background:var(--surface-2);padding:3px 8px;border-radius:20px;}
.block-chevron{font-size:.75rem;color:#aaa;transition:transform .25s ease;}
.block-header.open .block-chevron{transform:rotate(180deg);}
.block-body{max-height:0;overflow:hidden;transition:max-height .3s cubic-bezier(.4,0,.2,1);}
.block-body-inner{padding:0 14px 14px;}

.field-label{font-weight:800;color:var(--roxo);font-size:.8rem;margin-bottom:4px;display:block;}
.field-input{
  width:100%;border:2px solid var(--border-soft);border-radius:12px;
  padding:10px 12px;font-family:'Nunito',sans-serif;font-size:.88rem;
  font-weight:700;color:var(--text);outline:none;background:white;
}
.field-input:focus{border-color:var(--roxo);}

.cupom-row{display:flex;gap:8px;}
.cupom-row .field-input{flex:1;}
.btn-cupom{background:var(--roxo2);color:white;border:none;border-radius:12px;padding:10px 14px;font-family:'Fredoka One',cursive;font-size:.85rem;cursor:pointer;}
.cupom-ok{display:none;background:var(--selected-bg);border:2px solid var(--verde);border-radius:10px;padding:7px 12px;font-size:.78rem;font-weight:800;color:var(--text);margin-top:6px;}
.cupom-err{display:none;background:#FEE2E2;border:2px solid #EF4444;border-radius:10px;padding:7px 12px;font-size:.78rem;font-weight:800;color:#991B1B;margin-top:6px;}

.entrega-row{display:flex;gap:8px;margin-top:6px;}
.ent-btn{flex:1;border:2.5px solid var(--border-soft);border-radius:14px;padding:12px 6px;cursor:pointer;text-align:center;background:white;transition:all .2s;}
.ent-btn.selected{border-color:var(--roxo);background:var(--selected-bg);}
.ent-emoji{font-size:1.5rem;display:block;margin-bottom:3px;}
.ent-lbl{font-family:'Fredoka One',cursive;font-size:.85rem;color:var(--roxo);}
.ent-sub{font-size:.68rem;color:#888;}

.bairro-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:8px;}
.bairro-btn{border:2.5px solid var(--border-soft);border-radius:12px;padding:10px 6px;cursor:pointer;background:white;text-align:center;position:relative;}
.bairro-btn.selected{border-color:var(--roxo);background:var(--selected-bg);}
.bairro-btn.selected::after{content:'✓';position:absolute;top:5px;right:7px;color:var(--roxo);font-weight:900;font-size:.8rem;}
.bairro-nome{font-family:'Fredoka One',cursive;font-size:.82rem;color:var(--roxo);}
.bairro-taxa{font-family:'Fredoka One',cursive;font-size:.9rem;color:#15803D;}

.pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px;}
