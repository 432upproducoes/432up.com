function updateResumo(){
  checkMinimo();
  const total = calcTotal();
  const lines = [];
  if(S.nome) lines.push({k:'Faço ID', v:S.nome});
  carrinho.forEach(it => {
    lines.push({k:`${it.nome} (${formatQty(it.qty, it.tipoVendaEscolhido)})`, v:fmt(it.total)});
  });
  if(S.entrega) lines.push({k:'Entrega', v:S.entrega==='retirada'?'🏪 Retirada':'🛵 '+ (S.bairroNome||'Delivery')});
  if(S.frete > 0) lines.push({k:'Taxa', v:fmt(S.frete)});
  if(S.desconto > 0) lines.push({k:'Desconto', v:'− '+fmt(S.desconto)});

  const rLinhasEl = document.getElementById('r-linhas');
  if(rLinhasEl){
    rLinhasEl.innerHTML = lines.length
      ? lines.map(l => `<div class="r-linha"><span class="r-key">${l.k}</span><span class="r-val">${l.v}</span></div>`).join('')
      : '<div class="r-linha"><span class="r-key">Nada ainda</span><span class="r-val">—</span></div>';
  }

  const rTotalEl = document.getElementById('r-total');
  if(rTotalEl) rTotalEl.textContent = fmt(total);

  const fbTotalEl = document.getElementById('fb-total');
  if(fbTotalEl) fbTotalEl.textContent = fmt(total);
}

