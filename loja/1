  let msg = `🛒 *PEDIDO - Faço Pedidos · Mercadinho*\n\n👤 *Faço ID:* ${S.nome}\n\n`;
  carrinho.forEach(it => {
    msg += `• ${it.nome} — ${formatQty(it.qty, it.tipoVendaEscolhido)} — ${fmt(it.total)}\n`;
  });
  msg += `\n`;
  msg += S.entrega === 'retirada' ? `🏪 *Retirada no mercado*\n` : `🛵 *Delivery — ${S.bairroNome||''}*\n`;
  if(S.entrega === 'delivery'){
    const rua = document.getElementById('inp-rua')?.value?.trim();
    const num = document.getElementById('inp-num')?.value?.trim();
    const bairro = document.getElementById('inp-bairro')?.value?.trim();
    const comp = document.getElementById('inp-comp')?.value?.trim();
    if(rua) msg += `  📍 ${rua}${num?', '+num:''}\n`;
    if(bairro) msg += `  🏘️ ${bairro}\n`;
    if(comp) msg += `  🚪 ${comp}\n`;
    msg += `  🚗 Taxa: ${fmt(S.frete)}\n`;
  }
  if(S.horario) msg += `⏰ ${S.horario}\n`;
  if(S.desconto > 0) msg += `🏷️ Desconto: −${fmt(S.desconto)}\n`;
  const obs = document.getElementById('inp-obs')?.value?.trim();
  if(obs) msg += `📝 ${obs}\n`;
  msg += `\n━━━━━━━━━━━━━━\n💵 *TOTAL: ${fmt(total)}*\n\n_Pedido via Faço Pedidos_`;

  for(let i=0;i<carrinho.length;i++){
    const it = carrinho[i];
    try{
      await fetch(`${SB_URL}/rest/v1/pedidos`,{
        method:'POST',
        headers:{'Content-Type':'application/json','apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Prefer':'return=minimal'},
        body:JSON.stringify({
          cliente_nome:S.nome, entrega:S.entrega, bairro:S.bairroNome,
          produto:it.nome, quantidade:it.qty, unidade:it.unidade,
          preco_unitario:it.preco, total_item:it.total,
          frete:i===0?S.frete:0, desconto:i===0?S.desconto:0,
          total:i===0?total:it.total, item_index:i, total_itens:carrinho.length,
          status:'recebido', observacoes:obs||''
        })
      });
    }catch(e){}
  }

  salvarHistoricoPedido();

  const zapUrl = 'https://wa.me/'+ZAP_NUM+'?text='+encodeURIComponent(msg);
  const novaJanela = window.open(zapUrl, '_blank');
  if(!novaJanela || novaJanela.closed || typeof novaJanela.closed === 'undefined'){
    window.location.href = zapUrl;
  }

  document.getElementById('obg-title').textContent = `Pedido enviado, ${S.nome}!`;
  document.getElementById('obg-msg').textContent = 'Em breve confirmamos pelo WhatsApp 🛒';
  document.getElementById('tela-obrigado').style.display = 'flex';
}

function fecharObrigado(){
  document.getElementById('tela-obrigado').style.display = 'none';
  carrinho = [];
  S.categoria = null;
  S.entrega = null; S.bairroNome = null; S.frete = 0; S.horario = null; S.cupom = null; S.desconto = 0;

  document.getElementById('ent-ret').classList.remove('selected');
  document.getElementById('ent-del').classList.remove('selected');
  document.getElementById('delivery-wrap').style.display = 'none';
  document.getElementById('badge-entrega').textContent = 'Obrigatório';
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('selected'));
  document.getElementById('hor-input').style.display = 'none';
  const inpObs = document.getElementById('inp-obs'); if(inpObs) inpObs.value = '';
  const inpCupom = document.getElementById('inp-cupom'); if(inpCupom) inpCupom.value = '';
  document.getElementById('cupom-ok').style.display = 'none';
  document.getElementById('cupom-err').style.display = 'none';

  renderCorredores();
  document.getElementById('prod-grid').innerHTML = `<div class="empty-corredor" style="grid-column:1/-1"><span class="big">🛒</span>Toque em um corredor</div>`;
  document.getElementById('section-title').textContent = 'Escolha um corredor acima';
  renderDrawer();
  updateResumo();
  irParaHome();
}

function mostrarToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  clearTimeout(t._to);
  t._to = setTimeout(() => t.style.display = 'none', 2000);
}

function checkHorario(){
  const now = new Date(), dia = now.getDay(), h = now.getHours();
  const aberto = (dia === 0) ? (h >= 7 && h < 13) : (h >= 7 && h < 20);
  const bar = document.getElementById('status-bar');
  bar.className = aberto ? 'aberto' : 'fechado';
  bar.textContent = aberto ? '✅ Aberto agora' : '🔴 Fechado no momento';
}

document.addEventListener('DOMContentLoaded', async () => {
  initTheme();
  await loadCatalogo();
  loadAdminData();
  renderEstadoInicialProdutos();
  checkHorario();
  renderCorredores();
  renderBairros();
  updateResumo();

  // Botão Entrar (Tela 1 - Faço ID)
  document.getElementById('btn-entrar').addEventListener('click', entrarComId);
  document.getElementById('input-faco-id').addEventListener('keydown', function(e){
    if(e.key === 'Enter'){
      e.preventDefault();
      entrarComId();
    }
  });

  // Auto preenche último Faço ID usado
  const st = getIdStorage();
  if(st.ultimoId){
    document.getElementById('input-faco-id').value = st.ultimoId;
  }
});
</script>
</body>
