        <textarea id="modal-lead-msg" placeholder="Observações sobre o evento (data, local ou perfil)..." style="height: 65px; resize: none;"></textarea>
        <button type="submit" id="btn-submit-modal" class="btn-aurora-glass" style="width:100%; margin-top:6px;">Enviar Solicitação</button>
