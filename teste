  <style>
    /* ==========================================================================
       ARQUITETURA B2B HIGH-TICKET: ESTRUTURA DIRETA, SOFISTICADA E PRAGMÁTICA
       ========================================================================== */
    :root {
      --aurora-primary: #00F0FF;
      --aurora-primary-rgb: 0, 240, 255;
      --aurora-glow: rgba(var(--aurora-primary-rgb), 0.3);
      --aurora-border: rgba(var(--aurora-primary-rgb), 0.25);
      
      --aurora-accent: #39FF14;
      --aurora-accent-rgb: 57, 255, 20;

      --aurora-violet: #BF55FF;
      --aurora-violet-rgb: 191, 85, 255;

      --text-muted: rgba(255, 255, 255, 0.85);
      --transition-smooth: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .spa-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      margin-top: 85px;
    }

    .spa-section-block {
      padding-top: 10px;
      margin-bottom: 30px;
    }

    .spa-eyebrow-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--aurora-primary);
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid rgba(0, 240, 255, 0.28);
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 16px;
      text-transform: uppercase;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
    }

    .spa-title {
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 800;
      line-height: 1.15;
      color: #FFFFFF;
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }

    .spa-title span {
      background: linear-gradient(135deg, var(--aurora-primary) 0%, var(--aurora-accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .spa-text-block {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.65;
      margin-bottom: 35px;
      max-width: 720px;
    }

    /* PILARES TÉCNICOS B2B - RITMO DE VALOR PRÁTICO */
    .b2b-benefits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 40px;
    }

    .b2b-benefit-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px 16px;
      text-align: left;
    }

    .b2b-benefit-card h4 {
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: #FFFFFF;
      text-transform: uppercase;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .b2b-benefit-card h4 span {
      color: var(--aurora-primary);
    }

    .b2b-benefit-card p {
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.5;
      margin: 0;
    }

    /* GRIDS E GLASS CARDS DE AÇÃO EXCLUSIVA */
    .spa-grid-2 { 
      display: grid; 
      grid-template-columns: repeat(2, 1fr); 
      gap: 24px; 
    }

    .spa-card {
      background: linear-gradient(145deg, rgba(14, 20, 32, 0.96), rgba(8, 12, 20, 0.98)) !important;
      backdrop-filter: blur(25px) !important;
      -webkit-backdrop-filter: blur(25px) !important;
      border: 1px solid var(--aurora-border) !important;
      border-radius: 20px;
      padding: 32px 28px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: var(--transition-smooth);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .spa-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px var(--aurora-glow), 0 0 20px rgba(var(--aurora-primary-rgb), 0.2);
    }

    .spa-card[data-aurora="violet"] {
      border-color: rgba(var(--aurora-violet-rgb), 0.3) !important;
    }

    .spa-card[data-aurora="violet"]:hover {
      border-color: var(--aurora-violet) !important;
      box-shadow: 0 15px 35px rgba(var(--aurora-violet-rgb), 0.35), 0 0 20px rgba(var(--aurora-violet-rgb), 0.2);
    }

    .spa-card h3 {
      font-size: 1.25rem;
      color: #FFFFFF;
      margin-bottom: 12px;
      font-weight: 800;
      letter-spacing: -0.2px;
    }

    .spa-card p {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.65;
    }

    /* BOTÕES AURORA GLASS DE ALTA VISIBILIDADE */
    .btn-aurora-glass {
      background: var(--aurora-primary) !important;
      color: #08080A !important;
      font-weight: 800 !important;
      padding: 16px 28px !important;
      border-radius: 22px !important;
      border: none !important;
      cursor: pointer !important;
      display: inline-block !important;
      text-decoration: none !important;
      transition: var(--transition-smooth) !important;
      box-shadow: 0 0 20px var(--aurora-glow) !important;
      font-size: 0.88rem !important;
      letter-spacing: 0.5px !important;
    }

    .btn-aurora-glass:hover {
      background: var(--aurora-accent) !important;
      box-shadow: 0 0 30px rgba(var(--aurora-accent-rgb), 0.6) !important;
      transform: translateY(-2px) !important;
    }

    .btn-aurora-violet {
      background: var(--aurora-violet) !important;
      color: #08080A !important;
      box-shadow: 0 0 20px rgba(var(--aurora-violet-rgb), 0.4) !important;
    }

    .btn-aurora-violet:hover {
      background: #D47AFF !important;
      box-shadow: 0 0 30px rgba(191, 85, 255, 0.7) !important;
    }

    @media (max-width: 768px) {
      .b2b-benefits-grid { grid-template-columns: 1fr; }
      .spa-grid-2 { grid-template-columns: 1fr; }
      .spa-container { margin-top: 75px; padding: 30px 20px 60px; }
    }
  </style>
</head>
