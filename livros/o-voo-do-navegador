  <style>
    /* ==========================================================================
       NEUROLINGUAGEM EM CORES: CIANO WARP, ROXO VIOLETA & OURO PNL (ASS/SCHUMANN)
       ========================================================================== */
    :root {
      /* O Voo / A Nave Warp / O Espelho — Ciano Tech & Neon Electric */
      --warp-cyan: #00F0FF;
      --warp-glow: rgba(0, 240, 255, 0.3);
      --warp-pigment: rgba(0, 240, 255, 0.08);

      /* A Mente / A Regência / O Maestro — Roxo Ametista & Violeta Deep Space */
      --maestro-purple: #A855F7;
      --maestro-glow: rgba(168, 85, 247, 0.3);
      --maestro-pigment: rgba(168, 85, 247, 0.08);

      /* A Precisão / O Manche / O Alinhamento — Dourado Éden & Lime PNL */
      --precision-gold: #FFB800;
      --precision-lime: #00FF66;
      --precision-glow: rgba(0, 255, 102, 0.25);

      --book-glass-bg: rgba(10, 12, 18, 0.90);
      --book-glass-border: rgba(0, 240, 255, 0.22);
    }

    /* TRANSIÇÃO SCHUMANN ULTRA SUAVE NAS BORDAS (A PARTIR DA PÁGINA ASS) */
    @keyframes schumannBorderCycle {
      0%, 100% { border-color: rgba(0, 240, 255, 0.4); box-shadow: 0 0 25px rgba(0, 240, 255, 0.15); }
      25% { border-color: rgba(168, 85, 247, 0.4); box-shadow: 0 0 25px rgba(168, 85, 247, 0.15); }
      50% { border-color: rgba(255, 184, 0, 0.4); box-shadow: 0 0 25px rgba(255, 184, 0, 0.15); }
      75% { border-color: rgba(0, 255, 102, 0.4); box-shadow: 0 0 25px rgba(0, 255, 102, 0.15); }
    }

    .schumann-floating-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.02), rgba(0, 240, 255, 0.06)) !important;
      border: 1px solid rgba(0, 240, 255, 0.3);
      border-radius: 24px;
      padding: 32px;
      margin: 36px 0;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      animation: schumannBorderCycle 16s ease-in-out infinite;
    }

    .book-wrapper {
      position: relative;
      z-index: 2;
      max-width: 960px;
      margin: 0 auto;
      padding: 120px 24px 100px 24px;
      transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* CAPA HERO */
    .book-hero-cover {
      background: linear-gradient(135deg, rgba(10, 18, 28, 0.95), var(--warp-pigment), var(--maestro-pigment));
      border: 1px solid var(--warp-cyan);
      border-radius: 28px;
      padding: 50px 36px;
      margin-bottom: 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 35px var(--warp-glow);
    }

    .book-dossier-tag {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2.5px;
      color: var(--warp-cyan);
      text-transform: uppercase;
      display: block;
      margin-bottom: 12px;
    }

    .book-title-main {
      font-family: 'Cinzel', serif;
      font-size: clamp(2.3rem, 5vw, 4.2rem);
      font-weight: 900;
      line-height: 1.08;
      color: #FFFFFF;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    .book-title-main span {
      background: linear-gradient(135deg, var(--warp-cyan) 0%, var(--maestro-purple) 50%, var(--precision-lime) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .book-subtitle {
      font-family: 'EB Garamond', serif;
      font-style: italic;
      font-size: clamp(1.15rem, 2vw, 1.4rem);
      color: rgba(255, 255, 255, 0.88);
      max-width: 760px;
      margin: 0 auto 28px auto;
      line-height: 1.5;
    }

    .book-author-badge {
      display: inline-block;
      font-family: 'Cinzel', serif;
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #FFFFFF;
      padding: 8px 22px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* SUMÁRIO EM RITMO VISUAL */
    .book-toc-container {
      background: linear-gradient(135deg, rgba(14, 14, 22, 0.92), var(--warp-pigment));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--warp-glow);
      border-radius: 24px;
      padding: 32px 28px;
      margin-bottom: 60px;
    }

    .book-toc-title {
      font-family: 'Cinzel', serif;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #FFFFFF;
      text-transform: uppercase;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 10px;
    }

    .book-toc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 12px;
    }

    .toc-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      text-decoration: none;
      color: var(--text-muted);
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      transition: var(--transition-smooth);
    }

    .toc-item:hover {
      border-color: var(--warp-cyan);
      color: #FFFFFF;
      transform: translateX(4px);
    }

    .toc-item .num {
      font-family: 'Fira Code', monospace;
      font-weight: 700;
      font-size: 0.78rem;
      color: var(--warp-cyan);
    }

    .toc-item.maestro-item .num { color: var(--maestro-purple); }
    .toc-item.maestro-item:hover { border-color: var(--maestro-purple); }
    .toc-item.precision-item .num { color: var(--precision-lime); }
    .toc-item.precision-item:hover { border-color: var(--precision-lime); }

    /* BLOCOS DE CAPÍTULO */
    .book-chapter-block {
      background: var(--book-glass-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--book-glass-border);
      border-radius: 28px;
      padding: 44px 36px;
      margin-bottom: 50px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    }

    .chapter-badge {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--warp-cyan);
      margin-bottom: 8px;
      display: block;
    }

    .chapter-heading {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.7rem, 3.2vw, 2.4rem);
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 28px;
      line-height: 1.25;
    }

    .chapter-body {
      font-family: 'EB Garamond', serif;
      font-size: 1.2rem;
      line-height: 1.8;
      color: rgba(241, 245, 249, 0.92);
    }

    .chapter-body p {
      margin-bottom: 22px;
    }

    /* DROPCAP PNL */
    .dropcap-warp::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--warp-cyan);
      font-weight: 700;
    }

    .dropcap-maestro::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--maestro-purple);
      font-weight: 700;
    }

    .dropcap-precision::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--precision-lime);
      font-weight: 700;
    }

    /* CITATÓRIOS DESTACADOS */
    .pnl-quote-block {
      margin: 32px 0;
      padding: 24px;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(10, 10, 16, 0.6));
      border-left: 4px solid var(--warp-cyan);
      font-style: italic;
      color: #E0F2FE;
      font-size: 1.2rem;
      line-height: 1.65;
    }

    .pnl-quote-block.maestro-quote {
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(10, 10, 16, 0.6));
      border-left-color: var(--maestro-purple);
      color: #F3E8FF;
    }

    /* ESTILOS DE LISTA TEMÁTICA */
    .pnl-feature-list {
      list-style: none;
      padding: 0;
      margin: 24px 0;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
    }

    .pnl-feature-list li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 14px;
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.65;
    }

    .pnl-feature-list li::before {
      content: "✦";
      position: absolute;
      left: 0;
      top: 0;
      color: var(--warp-cyan);
      font-size: 0.9rem;
    }

    .pnl-feature-list.maestro-list li::before { color: var(--maestro-purple); }
    .pnl-feature-list.precision-list li::before { color: var(--precision-lime); }

    /* VARIAÇÃO REGÊNCIA / ORQUESTRA */
    .maestro-chapter-theme {
      border-color: rgba(168, 85, 247, 0.35) !important;
      background: linear-gradient(180deg, rgba(14, 10, 22, 0.95), rgba(20, 12, 28, 0.98)) !important;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85), 0 0 35px var(--maestro-glow);
    }
    .maestro-chapter-theme .chapter-badge { color: var(--maestro-purple); }

    /* VARIAÇÃO GUIA / OPERADOR */
    .precision-chapter-theme {
      border-color: rgba(0, 255, 102, 0.35) !important;
      background: linear-gradient(180deg, rgba(10, 18, 14, 0.95), rgba(8, 14, 18, 0.98)) !important;
    }
    .precision-chapter-theme .chapter-badge { color: var(--precision-lime); }

    /* EFEITO CORTINA CINEMATOGRÁFICA */
    .curtain-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: #000000;
      z-index: 9999;
      pointer-events: none;
      opacity: 0;
      transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .curtain-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    @media (max-width: 768px) {
      .book-wrapper { padding: 100px 16px 80px 16px; }
      .book-chapter-block { padding: 28px 20px; }
      .book-hero-cover { padding: 36px 20px; }
      .chapter-body { font-size: 1.1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .book-wrapper, .curtain-overlay {
        transition: opacity 0.2s linear !important;
      }
    }
  </style>

