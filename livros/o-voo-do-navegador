  <script>
    // REGISTRO DE JORNADA E NAVEGAÇÃO AUTOMÁTICA PARA A GRUTA
    const WORK_ID = "o-maestro-da-ia";

    function updateJourneyMemory() {
      try {
        let journey = JSON.parse(localStorage.getItem('quarta_via_journey') || '{}');
        if (!journey.visitedWorks) journey.visitedWorks = [];
        if (!journey.completedWorks) journey.completedWorks = [];

        if (!journey.visitedWorks.includes(WORK_ID)) {
          journey.visitedWorks.push(WORK_ID);
        }
        if (!journey.completedWorks.includes(WORK_ID)) {
          journey.completedWorks.push(WORK_ID);
        }

        journey.currentWork = WORK_ID;
        journey.grutaDiscovered = true;
        
        localStorage.setItem('quarta_via_journey', JSON.stringify(journey));
      } catch (e) {
        console.error("Erro ao salvar a jornada no localStorage:", e);
      }
    }

    // Registra a visita imediatamente
    updateJourneyMemory();

    // Lógica de transição suave e automática para gruta.html ao fim da leitura
    let transitionTriggered = false;

    function checkEndReached() {
      if (transitionTriggered) return;

      const scrollPosition = window.innerHeight + window.scrollY;
      const threshold = document.documentElement.scrollHeight - 80;

      if (scrollPosition >= threshold) {
        transitionTriggered = true;
        
        const wrapper = document.getElementById('bookWrapper');
        const curtain = document.getElementById('curtainOverlay');

        if (wrapper) wrapper.style.opacity = '0';
        if (curtain) curtain.classList.add('active');

        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const delay = isReducedMotion ? 200 : 1200;

        setTimeout(() => {
          window.location.href = 'gruta.html';
        }, delay);
      }
    }

    window.addEventListener('scroll', checkEndReached, { passive: true });
    window.addEventListener('touchmove', checkEndReached, { passive: true });
    window.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'PageDown', 'Space', 'End'].includes(e.code)) {
        setTimeout(checkEndReached, 100);
      }
    });
  </script>

