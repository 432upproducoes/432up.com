    /* ==========================================================================
       ESTRUTURA DE TRANSIÇÃO CINEMATOGRÁFICA DA CORTINA -> GRUTA
       ========================================================================== */
    #curtain-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
