  <script>
    (function() {
      const WORK_ID = 'a-verdadeira-riqueza';
      let transitionStarted = false;

      // 1. REGISTRO DE JORNADA LOCAL
      function recordJourneyState() {
        try {
          const journeyData = localStorage.getItem('quarta_via_journey');
          let journey = journeyData ? JSON.parse(journeyData) : {
            visitedWorks: [],
            completedWorks: [],
            currentWork: WORK_ID,
            grutaDiscovered: false
          };

          if (!journey.visitedWorks.includes(WORK_ID)) {
            journey.visitedWorks.push(WORK_ID);
          }
          if (!journey.completedWorks.includes(WORK_ID)) {
            journey.completedWorks.push(WORK_ID);
          }
          journey.currentWork = WORK_ID;

          localStorage.setItem('quarta_via_journey', JSON.stringify(journey));
        } catch (e) {
          console.warn('Não foi possível salvar o estado da jornada no localStorage:', e);
        }
      }

      // Executa registro inicial de visita
      recordJourneyState();

      // 2. DETECÇÃO DE FIM DE PÁGINA E TRANSIÇÃO CINEMATOGRÁFICA
      function triggerCurtainTransition() {
        if (transitionStarted) return;
        transitionStarted = true;

        const mainContent = document.getElementById('main-content');
        const curtainOverlay = document.getElementById('curtain-overlay');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
          window.location.href = 'gruta.html';
          return;
        }

        // Estágio 1: Escurecimento e Fade do Conteúdo
        if (mainContent) {
          mainContent.style.opacity = '0';
        }

        // Estágio 2: Fechamento da Cortina
        setTimeout(function() {
          if (curtainOverlay) {
            curtainOverlay.classList.add('active');
          }
        }, 400);

        // Estágio 3: Redirecionamento para a Gruta
        setTimeout(function() {
          window.location.href = 'gruta.html';
        }, 2000);
      }

      // Detecta a chegada na zona final da experiência
      function checkScrollCompletion() {
        if (transitionStarted) return;

        const scrollPosition = window.innerHeight + window.scrollY;
        const threshold = document.documentElement.scrollHeight - 80;

        if (scrollPosition >= threshold) {
          triggerCurtainTransition();
        }
      }

      // Event Listeners otimizados com Throttle
      let scrollTimeout;
      window.addEventListener('scroll', function() {
        if (scrollTimeout) return;
        scrollTimeout = setTimeout(function() {
          scrollTimeout = null;
          checkScrollCompletion();
        }, 100);
      }, { passive: true });

      window.addEventListener('touchmove', checkScrollCompletion, { passive: true });
    })();
  </script>

