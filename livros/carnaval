  <script>
    (function() {
      const WORK_SLUG = 'carnaval-o-aval-da-carne';
      let transitionStarted = false;

      // 1. REGISTRO E GESTÃO DE MEMÓRIA DA JORNADA
      function initializeJourneyMemory() {
        let journey = {};
        try {
          const stored = localStorage.getItem('432up_journey');
          if (stored) {
            journey = JSON.parse(stored);
          }
        } catch (e) {
          console.warn('LocalStorage bloqueado ou indisponível', e);
        }

        if (!journey.visitedWorks) journey.visitedWorks = [];
        if (!journey.completedWorks) journey.completedWorks = [];

        journey.currentWork = WORK_SLUG;
        if (!journey.visitedWorks.includes(WORK_SLUG)) {
          journey.visitedWorks.push(WORK_SLUG);
        }

        try {
          localStorage.setItem('432up_journey', JSON.stringify(journey));
        } catch (e) {}

        return journey;
      }

      function markWorkCompleted() {
        try {
          let journey = JSON.parse(localStorage.getItem('432up_journey') || '{}');
          if (!journey.completedWorks) journey.completedWorks = [];
          if (!journey.completedWorks.includes(WORK_SLUG)) {
            journey.completedWorks.push(WORK_SLUG);
          }
          journey.grutaDiscovered = true;
          localStorage.setItem('432up_journey', JSON.stringify(journey));
        } catch (e) {}
      }

      initializeJourneyMemory();


      // 2. DISPARO CINEMATOGRÁFICO DA TRANSIÇÃO PARA A GRUTA (COM ATRASO DE 2.5s)
      let grutaDelayTimer = null;

      function triggerCurtainTransition() {
        if (transitionStarted || grutaDelayTimer) return;

        // Aguarda 2.5 segundos (2500ms) após chegar ao fim antes de iniciar a transição
        grutaDelayTimer = setTimeout(function() {
          transitionStarted = true;

          markWorkCompleted();

          const mainContent = document.getElementById('main-book-container');
          const overlay = document.getElementById('curtain-transition-overlay');

          if (mainContent) {
            mainContent.classList.add('fade-out-narrative');
          }

          if (overlay) {
            overlay.classList.add('closing');
          }

          const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const delayTime = isReducedMotion ? 300 : 1800;

          setTimeout(function() {
            window.location.href = '../livros/gruta.html';
          }, delayTime);
        }, 2500); // <-- Altere aqui se quiser mais ou menos tempo (ex: 3000 para 3 segundos)
      }


      // 3. DETECÇÃO DE CHEGADA AO FIM (TOUCH, MOUSE, SCROLL)
      function checkCompletionZone() {
        if (transitionStarted) return;

        const targetZone = document.getElementById('zona-final-experiencia');
        if (!targetZone) return;

        const rect = targetZone.getBoundingClientRect();
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;

        // Dispara quando a zona final estiver visível na tela
        if (rect.top <= windowHeight * 0.85) {
          triggerCurtainTransition();
        }
      }

      window.addEventListener('scroll', checkCompletionZone, { passive: true });
      window.addEventListener('touchmove', checkCompletionZone, { passive: true });
      window.addEventListener('resize', checkCompletionZone, { passive: true });

      const manualBtn = document.getElementById('btn-manual-gruta');
      if (manualBtn) {
        manualBtn.addEventListener('click', function(e) {
          e.preventDefault();
          triggerCurtainTransition();
        });
      }
    })();
  </script>
</body>
</html>
