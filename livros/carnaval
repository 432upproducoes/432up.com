  <!-- Google Fonts & CSS Base -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/style.css">

  <style>
    /* ==========================================================================
       NEUROLINGUAGEM EM CORES: MATÉRIA (CARNE) vs. ESPÍRITO (CONSCIÊNCIA)
       ========================================================================== */
    :root {
      /* O Chassi / A Carne / A Festa — Magenta Neon & Laranja Vulcânico */
      --flesh-magenta: #FF007F;
      --flesh-orange: #FF8A4C;
      --flesh-glow: rgba(255, 0, 127, 0.3);
      --flesh-pigment: rgba(255, 0, 127, 0.08);

      /* O Som / Olodum / Bioengenharia Acústica — Dourado & Âmbar PNL */
      --sound-amber: #FFB800;
      --sound-glow: rgba(255, 184, 0, 0.3);
      --sound-pigment: rgba(255, 184, 0, 0.08);

      /* A Consciência / O Operador — Violeta Deep Space & Lime Alpha */
      --spirit-violet: #A855F7;
      --spirit-lime: #00FF66;
      --spirit-glow: rgba(0, 255, 102, 0.25);

      /* Palco & IA Integration Colors */
      --pnl-ia-cyan: #00F0FF;
      --pnl-human: #A855F7;

      --text-muted: rgba(255, 255, 255, 0.65);
      --transition-smooth: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);

      --book-glass-bg: rgba(10, 12, 18, 0.90);
      --book-glass-border: rgba(255, 0, 127, 0.22);
    }

    /* TRANSIÇÃO SCHUMANN ULTRA SUAVE NAS BORDAS */
    @keyframes schumannBorderCycle {
      0%, 100% { border-color: rgba(255, 0, 127, 0.4); box-shadow: 0 0 25px rgba(255, 0, 127, 0.15); }
      25% { border-color: rgba(255, 184, 0, 0.4); box-shadow: 0 0 25px rgba(255, 184, 0, 0.15); }
      50% { border-color: rgba(168, 85, 247, 0.4); box-shadow: 0 0 25px rgba(168, 85, 247, 0.15); }
      75% { border-color: rgba(0, 255, 102, 0.4); box-shadow: 0 0 25px rgba(0, 255, 102, 0.15); }
    }

    .schumann-floating-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.02), rgba(255, 0, 127, 0.06)) !important;
      border: 1px solid rgba(255, 0, 127, 0.3);
      border-radius: 24px;
      padding: 32px;
      margin: 36px 0;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      animation: schumannBorderCycle 16s ease-in-out infinite;
    }

    .book-wrapper {
      position: relative;
      z-index: 2;
      max-width: 960px;
      margin: 0 auto;
      padding: 60px 24px;
      transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .book-wrapper.fade-out-narrative {
      opacity: 0;
      transform: translateY(-20px);
      pointer-events: none;
    }

    /* CAPA HERO */
    .book-hero-cover {
      background: linear-gradient(135deg, rgba(14, 10, 20, 0.95), var(--flesh-pigment), var(--sound-pigment));
      border: 1px solid var(--flesh-magenta);
      border-radius: 28px;
      padding: 50px 36px;
      margin-bottom: 60px;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 35px var(--flesh-glow);
    }

    .book-dossier-tag {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2.5px;
      color: var(--flesh-magenta);
      text-transform: uppercase;
      display: block;
      margin-bottom: 12px;
    }

    .book-title-main {
      font-family: 'Cinzel', serif;
      font-size: clamp(2.3rem, 5vw, 4.2rem);
      font-weight: 900;
      line-height: 1.08;
      color: #FFFFFF;
      letter-spacing: 1px;
      margin-bottom: 16px;
    }

    .book-title-main span {
      background: linear-gradient(135deg, var(--flesh-magenta) 0%, var(--sound-amber) 50%, var(--spirit-lime) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .book-subtitle {
      font-family: 'EB Garamond', serif;
      font-style: italic;
      font-size: clamp(1.15rem, 2vw, 1.4rem);
      color: rgba(255, 255, 255, 0.88);
      max-width: 760px;
      margin: 0 auto 28px auto;
      line-height: 1.5;
    }

    .book-author-badge {
      display: inline-block;
      font-family: 'Cinzel', serif;
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #FFFFFF;
      padding: 8px 22px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* SUMÁRIO EM RITMO VISUAL */
    .book-toc-container {
      background: linear-gradient(135deg, rgba(14, 14, 22, 0.92), var(--flesh-pigment));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--flesh-glow);
      border-radius: 24px;
      padding: 32px 28px;
      margin-bottom: 60px;
    }

    .book-toc-title {
      font-family: 'Cinzel', serif;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #FFFFFF;
      text-transform: uppercase;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 10px;
    }

    .book-toc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 12px;
    }

    .toc-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      text-decoration: none;
      color: var(--text-muted);
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      transition: var(--transition-smooth);
    }

    .toc-item:hover {
      border-color: var(--flesh-magenta);
      color: #FFFFFF;
      transform: translateX(4px);
    }

    .toc-item .num {
      font-family: 'Fira Code', monospace;
      font-weight: 700;
      font-size: 0.78rem;
      color: var(--flesh-magenta);
    }

    .toc-item.sound-item .num { color: var(--sound-amber); }
    .toc-item.sound-item:hover { border-color: var(--sound-amber); }
    .toc-item.spirit-item .num { color: var(--spirit-lime); }
    .toc-item.spirit-item:hover { border-color: var(--spirit-lime); }

    /* BLOCOS DE CAPÍTULO */
    .book-chapter-block {
      background: var(--book-glass-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--book-glass-border);
      border-radius: 28px;
      padding: 44px 36px;
      margin-bottom: 50px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
    }

    .chapter-badge {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--flesh-magenta);
      margin-bottom: 8px;
      display: block;
    }

    .chapter-heading {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.7rem, 3.2vw, 2.4rem);
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 28px;
      line-height: 1.25;
    }

    .chapter-body {
      font-family: 'EB Garamond', serif;
      font-size: 1.2rem;
      line-height: 1.8;
      color: rgba(241, 245, 249, 0.92);
    }

    .chapter-body p {
      margin-bottom: 22px;
    }

    /* DROPCAP PNL */
    .dropcap-flesh::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--flesh-magenta);
      font-weight: 700;
    }

    .dropcap-sound::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--sound-amber);
      font-weight: 700;
    }

    .dropcap-spirit::first-letter {
      font-family: 'Cinzel', serif;
      float: left;
      font-size: 3.8em;
      line-height: 0.75;
      padding-top: 4px;
      padding-right: 10px;
      color: var(--spirit-lime);
      font-weight: 700;
    }

    /* CITATÓRIOS DESTACADOS */
    .pnl-quote-block {
      margin: 32px 0;
      padding: 24px;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(255, 0, 127, 0.1), rgba(10, 10, 16, 0.6));
      border-left: 4px solid var(--flesh-magenta);
      font-style: italic;
      color: #FFE4E6;
      font-size: 1.2rem;
      line-height: 1.65;
    }

    .pnl-quote-block.sound-quote {
      background: linear-gradient(135deg, rgba(255, 184, 0, 0.1), rgba(10, 10, 16, 0.6));
      border-left-color: var(--sound-amber);
      color: #FEF3C7;
    }

    /* ESTILOS DE LISTA TEMÁTICA */
    .pnl-feature-list {
      list-style: none;
      padding: 0;
      margin: 24px 0;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
    }

    .pnl-feature-list li {
      position: relative;
      padding-left: 28px;
      margin-bottom: 14px;
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.65;
    }

    .pnl-feature-list li::before {
      content: "✦";
      position: absolute;
      left: 0;
      top: 0;
      color: var(--flesh-magenta);
      font-size: 0.9rem;
    }

    .pnl-feature-list.sound-list li::before { color: var(--sound-amber); }
    .pnl-feature-list.spirit-list li::before { color: var(--spirit-lime); }

    /* VARIAÇÃO SONORA / OLODUM */
    .sound-chapter-theme {
      border-color: rgba(255, 184, 0, 0.35) !important;
      background: linear-gradient(180deg, rgba(18, 14, 10, 0.95), rgba(24, 18, 8, 0.98)) !important;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.85), 0 0 35px var(--sound-glow);
    }
    .sound-chapter-theme .chapter-badge { color: var(--sound-amber); }

    /* VARIAÇÃO OPERADOR / MENTE INTEGRADA */
    .spirit-chapter-theme {
      border-color: rgba(0, 255, 102, 0.35) !important;
      background: linear-gradient(180deg, rgba(10, 18, 14, 0.95), rgba(8, 14, 18, 0.98)) !important;
    }
    .spirit-chapter-theme .chapter-badge { color: var(--spirit-lime); }

    /* ESTILO SINTETIZADO DO BANNER DO PALCO */
    .exact-cta-banner-stage {
      text-align: center;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.06), rgba(168, 85, 247, 0.08)) !important;
      border: 1px solid var(--pnl-ia-cyan);
      border-radius: 28px;
      padding: 50px 32px;
      margin-top: 60px;
      margin-bottom: 20px;
      position: relative;
      overflow: hidden;
      animation: schumannBorderCycle 16s ease-in-out infinite;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 35px rgba(0, 240, 255, 0.15);
    }

    .stage-tag-micro {
      font-family: 'Fira Code', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 3px;
      color: var(--pnl-ia-cyan);
      text-transform: uppercase;
      display: block;
      margin-bottom: 12px;
    }

    .stage-editorial-title {
      font-family: 'Cinzel', serif;
      font-size: clamp(1.8rem, 3.8vw, 2.6rem);
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: 1px;
      line-height: 1.25;
      margin-bottom: 18px;
    }

    .stage-editorial-title span {
      background: linear-gradient(135deg, var(--pnl-ia-cyan), var(--pnl-human));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .stage-editorial-lead {
      font-family: 'EB Garamond', serif;
      font-size: clamp(1.15rem, 2vw, 1.35rem);
      font-style: italic;
      color: rgba(255, 255, 255, 0.88);
      max-width: 780px;
      margin: 0 auto 28px auto;
      line-height: 1.6;
    }

    .stage-editorial-lead span {
      color: var(--pnl-ia-cyan);
      font-style: normal;
      font-weight: 600;
    }

    .btn-enter-stage {
      background: linear-gradient(135deg, var(--pnl-ia-cyan) 0%, var(--pnl-human) 100%);
      color: #08080A;
      font-family: 'Cinzel', serif;
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      padding: 18px 40px;
      border-radius: 24px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.35);
      transition: all 0.4s ease;
    }

    .btn-enter-stage:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 10px 40px rgba(168, 85, 247, 0.5);
      color: #FFFFFF;
    }

    /* SISTEMA DA CORTINA CINEMATOGRÁFICA DE TRANSIÇÃO PARA A GRUTA */
    #curtain-transition-overlay {
      position: fixed;
      inset: 0;
      z-index: 99999;
      pointer-events: none;
      display: flex;
      justify-content: space-between;
      overflow: hidden;
    }

    .curtain-panel {
      width: 50.5%;
      height: 100%;
      background: #050507;
      position: absolute;
      top: 0;
      transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9);
      will-change: transform;
    }

    .curtain-panel.left-panel {
      left: 0;
      transform: translateX(-100%);
      border-right: 1px solid rgba(255, 0, 127, 0.3);
    }

    .curtain-panel.right-panel {
      right: 0;
      transform: translateX(100%);
      border-left: 1px solid rgba(255, 0, 127, 0.3);
    }

    #curtain-transition-overlay.closing .left-panel {
      transform: translateX(0);
    }

    #curtain-transition-overlay.closing .right-panel {
      transform: translateX(0);
    }

    .curtain-sigil-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.8);
      opacity: 0;
      z-index: 100000;
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      letter-spacing: 4px;
      color: var(--flesh-magenta);
      text-transform: uppercase;
      text-align: center;
      transition: all 0.8s ease 0.6s;
      pointer-events: none;
    }

    #curtain-transition-overlay.closing .curtain-sigil-center {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      .curtain-panel { transition: transform 0.2s ease !important; }
      .book-wrapper { transition: opacity 0.2s ease !important; }
      .curtain-sigil-center { transition: opacity 0.2s ease !important; }
    }

    /* RODAPÉ INTEGRADO DA OBRA */
    .site-footer-custom {
      position: relative;
      z-index: 5;
      max-width: 960px;
      margin: 0 auto 40px auto;
      padding: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .footer-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-copy-text {
      color: rgba(255, 255, 255, 0.6);
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }

    @media (max-width: 768px) {
      .book-wrapper { padding: 40px 16px; }
      .book-chapter-block { padding: 28px 20px; }
      .book-hero-cover { padding: 36px 20px; }
      .chapter-body { font-size: 1.1rem; }
      .exact-cta-banner-stage { padding: 36px 20px; }
      .btn-enter-stage { width: 100%; justify-content: center; padding: 16px 20px; font-size: 0.85rem; }
      .footer-bar {
        flex-direction: column;
        text-align: center;
      }
    }
  </style>

  <script src="../script/script.js" defer></script>
</head>
<body>

  <!-- CANVAS DE BACKGROUND FIXO -->
  <canvas id="orbit-canvas"></canvas>
  <div id="plasmaLayer" class="plasma-top-layer"></div>

  <!-- OVERLAY CINEMATOGRÁFICO DE TRANSIÇÃO -->
  <div id="curtain-transition-overlay" aria-hidden="true">
    <div class="curtain-panel left-panel"></div>
    <div class="curtain-panel right-panel"></div>
    <div class="curtain-sigil-center">
      <div style="font-size: 0.7rem; color: rgba(255,255,255,0.5); margin-bottom: 8px;">A QUARTA VIA</div>
      A CORTINA SE FECHOU<br>
      <span style="font-size: 0.75rem; color: #FFFFFF; opacity: 0.8;">ENTRANDO NA GRUTA...</span>
    </div>
  </div>

  <!-- LEITOR E CONTEÚDO PRINCIPAL DO LIVRO -->
  <main class="book-wrapper" id="main-book-container">

    <!-- DOSSIÊ & CAPA HERO -->
    <section id="cap-cover" class="book-hero-cover">
      <span class="book-dossier-tag">DOSSIÊ CONFIDENCIAL · A QUARTA VIA</span>
      <h1 class="book-title-main">Carnaval: <br><span>O Aval da Carne</span></h1>
      <p class="book-subtitle">A Teologia Viva do Chassi, o Falso Jejum e o Equilíbrio da Consciência</p>
      
      <div style="margin-top: 20px;">
        <span class="book-author-badge">POR CORINGA MAIA</span>
      </div>
    </section>

