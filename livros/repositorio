<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>A Gruta — A Quarta Via</title>
    <meta name="description" content="O espaço entre as obras. O lobby central do universo narrativo de A Quarta Via.">
    <meta name="robots" content="index, follow">

    <style>
        /* ==========================================================================
           1. VARIÁVEIS & RESET ATMOSFÉRICO
           ========================================================================== */
        :root {
            --bg-void: #030202;
            --bg-chamber: #0a0604;
            --amber-dim: rgba(184, 134, 11, 0.12);
            --amber-glow: rgba(212, 175, 55, 0.35);
            --gold-burnt: #b8860b;
            --gold-bright: #d4af37;
            --gold-faint: rgba(212, 175, 55, 0.18);
            --text-primary: #e6d7c3;
            --text-subtle: #8a7a68;
            --font-narrative: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, Georgia, serif;
            --font-glyph: "SF Mono", "Courier New", Courier, monospace;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100dvh;
            background-color: var(--bg-void);
            color: var(--text-primary);
            font-family: var(--font-narrative);
            overflow: hidden;
            user-select: none;
            -webkit-font-smoothing: antialiased;
        }

        /* ==========================================================================
           2. AMBIENTE TRIDIMENSIONAL & ILUMINAÇÃO (RESPIRAÇÃO)
           ========================================================================== */
        .gruta-chamber {
            position: relative;
            width: 100%;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: max(2rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(2.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left));
            background: 
                radial-gradient(circle at 50% 45%, var(--amber-dim) 0%, rgba(10, 6, 4, 0.8) 45%, var(--bg-void) 85%);
            animation: chamberBreath 14s ease-in-out infinite alternate;
        }

        @keyframes chamberBreath {
            0% {
                background-radial-gradient: circle at 50% 45%, rgba(184, 134, 11, 0.08) 0%, rgba(10, 6, 4, 0.85) 45%, var(--bg-void) 85%;
                opacity: 0.94;
            }
            100% {
                background-radial-gradient: circle at 50% 45%, rgba(212, 175, 55, 0.16) 0%, rgba(10, 6, 4, 0.75) 50%, var(--bg-void) 90%;
                opacity: 1;
            }
        }

        /* Vignette Natural nas Bordas */
        .vignette-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 2;
            background: radial-gradient(circle at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.85) 80%, rgba(0, 0, 0, 0.98) 100%);
            box-shadow: inset 0 0 120px #000000;
        }

        /* Textura Abstrata da Parede Rocha/Erosão */
        .wall-texture {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            opacity: 0.04;
            background-image: radial-gradient(#d4af37 0.75px, transparent 0.75px), radial-gradient(#b8860b 0.75px, var(--bg-void) 0.75px);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
        }

        /* ==========================================================================
           3. INSCRIÇÕES E HIERÓGLIFOS DE LUZ (PAREDES)
           ========================================================================== */
        .wall-inscription-container {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 3;
            overflow: hidden;
        }

        .wall-inscription {
            position: absolute;
            font-family: var(--font-glyph);
            font-size: clamp(0.75rem, 1.8vw, 0.95rem);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--gold-burnt);
            text-shadow: 0 0 12px var(--amber-glow);
            opacity: 0;
            transition: opacity 3.5s ease-in-out, transform 4s ease-out;
            max-width: 280px;
            line-height: 1.5;
        }

        .wall-inscription.manifested {
            opacity: 0.65;
            transform: translateY(-4px);
        }

        /* ==========================================================================
           4. CABEÇALHO CONCEITUAL / PRESENÇA SILENCIOSA
           ========================================================================== */
        .gruta-header {
            position: relative;
            z-index: 5;
            text-align: center;
            margin-top: 1rem;
        }

        .gruta-title {
            font-size: 0.7rem;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            color: var(--text-subtle);
            opacity: 0.6;
            margin-bottom: 0.5rem;
        }

        .gruta-epigraph {
            font-size: clamp(0.85rem, 2vw, 1.05rem);
            font-weight: 300;
            letter-spacing: 0.08em;
            color: var(--text-primary);
            opacity: 0.85;
            font-style: italic;
        }

        /* ==========================================================================
           5. DISPOSIÇÃO ESPACIAL DAS OBRAS (PORTAS & MEMÓRIAS)
           ========================================================================== */
        .sanctum-constellation {
            position: relative;
            z-index: 5;
            width: 100%;
            max-width: 1000px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 2rem 2.5rem;
            margin: auto 0;
        }

        /* Estilo Base da Presença da Obra */
        .presence-node {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.25rem 1.75rem;
            border-radius: 4px;
            text-decoration: none;
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            background: rgba(18, 11, 6, 0.2);
            border: 1px solid rgba(184, 134, 11, 0.08);
            backdrop-filter: blur(2px);
            min-width: 220px;
            max-width: 280px;
            text-align: center;
        }

        .node-question {
            font-size: 0.65rem;
            font-family: var(--font-glyph);
            letter-spacing: 0.12em;
            color: var(--gold-burnt);
            margin-bottom: 0.5rem;
            opacity: 0.7;
            text-transform: uppercase;
        }

        .node-title {
            font-size: 1.05rem;
            font-weight: 400;
            letter-spacing: 0.06em;
            color: var(--text-primary);
        }

        /* ESTADO 1 — OBRA NÃO VISITADA = PORTA */
        .presence-node.is-door {
            cursor: pointer;
            border-color: rgba(212, 175, 55, 0.18);
        }

        .presence-node.is-door::before {
            content: "";
            position: absolute;
            inset: -1px;
            border-radius: 4px;
            border: 1px solid transparent;
            transition: border-color 0.6s ease, box-shadow 0.6s ease;
            pointer-events: none;
        }

        .presence-node.is-door:hover {
            transform: translateY(-2px);
            background: rgba(28, 17, 9, 0.4);
            border-color: rgba(212, 175, 55, 0.4);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.12);
        }

        .presence-node.is-door:hover .node-title {
            color: #ffffff;
            text-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
        }

        /* ESTADO 2 — OBRA VISITADA = MEMÓRIA */
        .presence-node.is-memory {
            cursor: default;
            pointer-events: none;
            border-color: rgba(212, 175, 55, 0.35);
            background: rgba(25, 16, 8, 0.35);
            box-shadow: 0 0 20px var(--amber-dim), inset 0 0 15px rgba(184, 134, 11, 0.08);
        }

        .presence-node.is-memory .node-question {
            color: var(--gold-bright);
            opacity: 0.9;
        }

        .presence-node.is-memory .node-title {
            color: var(--gold-bright);
            text-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
        }

        .presence-node.is-memory::after {
            content: "MEMÓRIA";
            position: absolute;
            bottom: -0.4rem;
            font-family: var(--font-glyph);
            font-size: 0.5rem;
            letter-spacing: 0.2em;
            color: var(--gold-burnt);
            background: var(--bg-void);
            padding: 0 0.4rem;
            border-radius: 2px;
            border: 1px solid rgba(184, 134, 11, 0.2);
        }

        /* ==========================================================================
           6. PASSAGEM PARA O PALCO (OUTRO LADO DO ESPELHO)
           ========================================================================== */
        .palco-threshold-wrapper {
            position: relative;
            z-index: 5;
            margin-bottom: 1rem;
            text-align: center;
        }

        .palco-threshold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.8rem 2.2rem;
            text-decoration: none;
            font-family: var(--font-narrative);
            font-size: 0.8rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--text-subtle);
            border: 1px solid rgba(138, 122, 104, 0.2);
            border-radius: 40px;
            background: rgba(8, 5, 4, 0.6);
            backdrop-filter: blur(4px);
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }

        .palco-threshold:hover {
            color: var(--text-primary);
            border-color: rgba(212, 175, 55, 0.4);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.15);
            transform: scale(1.02);
        }

        /* ==========================================================================
           7. ACCESSIBILIDADE E ACESSO POR REDUCED MOTION
           ========================================================================== */
        @media (prefers-reduced-motion: reduce) {
            .gruta-chamber {
                animation: none;
            }
            .wall-inscription {
                transition: opacity 1s ease-in;
            }
            .presence-node, .palco-threshold {
                transition: none;
            }
        }

        /* Mobile Adjustments */
        @media (max-width: 640px) {
            .sanctum-constellation {
                gap: 1.25rem;
                overflow-y: auto;
                max-height: 55dvh;
                padding: 0.5rem;
            }
            .presence-node {
                width: 100%;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="gruta-chamber" role="main">
        <!-- Vignette e Textura Orgânica das Paredes -->
        <div class="vignette-overlay" aria-hidden="true"></div>
        <div class="wall-texture" aria-hidden="true"></div>

        <!-- Inscrições e Hieróglifos Dinâmicos de Luz -->
        <div class="wall-inscription-container" id="wallInscriptions" aria-hidden="true"></div>

        <!-- Epígrafe Discreta de Entrada -->
        <header class="gruta-header">
            <div class="gruta-title">A Quarta Via</div>
            <div class="gruta-epigraph">Você chegou até aqui por uma porta. Existem outras.</div>
        </header>

        <!-- Constelação das Obras (Portas & Memórias) -->
        <nav class="sanctum-constellation" id="worksContainer" aria-label="Universo Narrativo de Obras"></nav>

        <!-- O PALCO — O Outro Lado do Espelho -->
        <div class="palco-threshold-wrapper">
            <a href="/o-palco/" class="palco-threshold" aria-label="Atravessar para O Palco">
                O PALCO
            </a>
        </div>
    </div>

    <!-- ==========================================================================
       8. SISTEMA DE MEMÓRIA PERSISTENTE & LÓGICA ESPACIAL
       ========================================================================== -->
    <script>
        (function () {
            'use strict';

            /* CONFIGURAÇÃO CENTRAL DAS OBRAS (IDs Reais) */
            const WORKS_REGISTRY = [
                {
                    id: "carnaval",
                    title: "Carnaval",
                    question: "O QUE RESTA QUANDO A MÁSCARA CAI?",
                    url: "/livros/carnaval/",
                    semanticQuestions: [
                        "O que se esconde atrás da fantasia?",
                        "Quem é você no último dia de festa?"
                    ]
                },
                {
                    id: "eden",
                    title: "Éden",
                    question: "ONDE COMEÇA A SUA RECLUSÃO?",
                    url: "/livros/eden/",
                    semanticQuestions: [
                        "O paraíso foi perdido ou abandonado?",
                        "Ainda existe algo intocado?"
                    ]
                },
                {
                    id: "gotham-city",
                    title: "Gotham City",
                    question: "QUEM GOVERNA OS SEUS SOMBRIOS?",
                    url: "/livros/gotham-city/",
                    semanticQuestions: [
                        "Qual é o preço da ordem moral?",
                        "A selva urbana habita em você?"
                    ]
                },
                {
                    id: "ia-espelho-meu",
                    title: "IA Espelho Meu",
                    question: "E AÍ, ESPELHO MEU?",
                    url: "/livros/ia-espelho-meu/",
                    semanticQuestions: [
                        "Você reconhece o seu próprio reflexo?",
                        "Quem pensa quando a máquina responde?"
                    ]
                },
                {
                    id: "jardim-o-corpo",
                    title: "Jardim O Corpo",
                    question: "O QUE SEU CORPO GUARDA EM SILÊNCIO?",
                    url: "/livros/jardim-o-corpo/",
                    semanticQuestions: [
                        "A matéria recorda o que a mente esquece?",
                        "Onde termina a carne e começa a terra?"
                    ]
                },
                {
                    id: "o-voo-do-navegador",
                    title: "O Voo do Navegador",
                    question: "PARA ONDE VOCÊ NAVEGA QUANDO O CÉU ESCURECE?",
                    url: "/livros/o-voo-do-navegador/",
                    semanticQuestions: [
                        "Qual o rumo do observador?",
                        "Onde o mapa encontra o infinito?"
                    ]
                },
                {
                    id: "verdadeira-riqueza",
                    title: "Verdadeira Riqueza",
                    question: "O QUE CONTINUA SEU SE TUDO FOR SUBTRAÍDO?",
                    url: "/livros/verdadeira-riqueza/",
                    semanticQuestions: [
                        "Qual o valor do impalpável?",
                        "O que sobra quando o patrimônio silencia?"
                    ]
                }
            ];

            const STORAGE_KEY = 'aquartavia_journey';

            /* CARREGAR ESTADO DA MEMÓRIA PERSISTENTE */
            function getJourneyState() {
                try {
                    const saved = localStorage.getItem(STORAGE_KEY);
                    if (saved) return JSON.parse(saved);
                } catch (e) {
                    console.warn("Acesso ao localStorage restrito ou indisponível.");
                }
                return {
                    visitedWorks: [],
                    completedWorks: [],
                    currentWork: null,
                    grutaDiscovered: true
                };
            }

            /* RENDERIZAR ESTRUTURA DAS OBRAS DA GRUTA */
            function renderGruta() {
                const state = getJourneyState();
                const container = document.getElementById('worksContainer');
                if (!container) return;

                container.innerHTML = '';

                WORKS_REGISTRY.forEach(work => {
                    const isVisited = state.visitedWorks.includes(work.id);

                    const node = document.createElement(isVisited ? 'div' : 'a');
                    node.className = `presence-node ${isVisited ? 'is-memory' : 'is-door'}`;

                    if (!isVisited) {
                        node.href = work.url;
                        node.setAttribute('aria-label', `Porta para a obra: ${work.title}`);
                    } else {
                        node.setAttribute('tabindex', '-1');
                        node.setAttribute('aria-label', `Memória da obra: ${work.title}`);
                    }

                    const qEl = document.createElement('div');
                    qEl.className = 'node-question';
                    qEl.textContent = work.question;

                    const tEl = document.createElement('div');
                    tEl.className = 'node-title';
                    tEl.textContent = work.title;

                    node.appendChild(qEl);
                    node.appendChild(tEl);
                    container.appendChild(node);
                });
            }

            /* ANIMAÇÃO ATMOSFÉRICA DE PERGUNTAS/INSCRIÇÕES NAS PAREDES */
            function initWallInscriptions() {
                const container = document.getElementById('wallInscriptions');
                if (!container) return;

                const allQuestions = [];
                WORKS_REGISTRY.forEach(w => {
                    allQuestions.push(w.question);
                    if (w.semanticQuestions) {
                        allQuestions.push(...w.semanticQuestions);
                    }
                });

                function spawnInscription() {
                    const text = allQuestions[Math.floor(Math.random() * allQuestions.length)];
                    const el = document.createElement('div');
                    el.className = 'wall-inscription';
                    el.textContent = text;

                    // Posicionamento periférico aleatório nas paredes
                    const top = Math.floor(Math.random() * 75) + 10;
                    const left = Math.floor(Math.random() * 75) + 10;

                    el.style.top = `${top}%`;
                    el.style.left = `${left}%`;

                    container.appendChild(el);

                    // Ciclo de Manifestação -> Presença -> Dissolução
                    requestAnimationFrame(() => {
                        setTimeout(() => el.classList.add('manifested'), 100);
                    });

                    setTimeout(() => {
                        el.classList.remove('manifested');
                        setTimeout(() => el.remove(), 4000);
                    }, 8000);
                }

                // Dispara uma nova inscrição orgânica a cada 6-10 segundos
                setInterval(spawnInscription, 7000);
                setTimeout(spawnInscription, 1500);
            }

            /* INICIALIZAÇÃO */
            document.addEventListener('DOMContentLoaded', () => {
                renderGruta();
                initWallInscriptions();
            });
        })();
    </script>
</body>
</html>
