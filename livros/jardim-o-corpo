      }
    }

    function markWorkCompleted() {
      try {
        let journey = JSON.parse(localStorage.getItem('432up_journey_state')) || {
          visitedWorks: [],
          completedWorks: [],
          currentWork: null,
          grutaDiscovered: false
        };

        if (!journey.completedWorks.includes(CURRENT_WORK_ID)) {
          journey.completedWorks.push(CURRENT_WORK_ID);
        }
        journey.grutaDiscovered = true;
        
        localStorage.setItem('432up_journey_state', JSON.stringify(journey));
      } catch (e) {
        console.warn('LocalStorage inacessível para marcar conclusão:', e);
      }
    }

    // TRANSIÇÃO CINEMATOGRÁFICA DE TRANSIÇÃO AUTOMÁTICA
    let transitionStarted = false;

    function triggerCurtainTransition() {
      if (transitionStarted) return;
      transitionStarted = true;

      markWorkCompleted();

      const mainContent = document.getElementById('main-content');
      const curtain = document.getElementById('curtain-overlay');

      // 1. Inicia o fade do conteúdo
      if (mainContent) mainContent.style.opacity = '0.1';

      // 2. Aciona o fechamento da cortina
      if (curtain) curtain.classList.add('active');

      // 3. Aguarda o tempo exato da animação cinematográfica e redireciona
      setTimeout(() => {
        window.location.href = 'gruta.html';
      }, 1400);
    }

    // DETECTOR MULTI-INPUT DE CHEGADA AO FINAL DA LEITURA
    function checkScrollCompletion() {
      if (transitionStarted) return;

      const scrollPosition = window.innerHeight + window.scrollY;
      const threshold = document.documentElement.scrollHeight - 100; // Tolerância de 100px do final da página

      if (scrollPosition >= threshold) {
        triggerCurtainTransition();
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      registerWorkEntry();

      // Listeners robustos para wheel, touch, teclado e scroll
      window.addEventListener('scroll', checkScrollCompletion, { passive: true });
      window.addEventListener('touchmove', checkScrollCompletion, { passive: true });
      window.addEventListener('keydown', (e) => {
        if (['PageDown', 'End', 'ArrowDown', 'Space'].includes(e.key)) {
          setTimeout(checkScrollCompletion, 100);
        }
      });
    });
